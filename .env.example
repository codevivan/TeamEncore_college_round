# AXON — Environment Configuration Example
# Copy this file to .env and configure the values for your environment:
# cp .env.example .env

# =============================================================================
# Authentication (Clerk)
# Get keys from: https://dashboard.clerk.com
# =============================================================================
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
NODE_ENV=development

# =============================================================================
# Database (Optional - MySQL via Drizzle ORM)
# =============================================================================
# DATABASE_URL=mysql://user:password@localhost:3306/axon

# =============================================================================
# Supabase Integration (Optional - PostgREST versioning & audit logs sync)
# =============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# Hosting & Deployment Integrations (Optional)
# =============================================================================
# GITHUB_TOKEN=ghp_your_github_personal_access_token
# VERCEL_TOKEN=your_vercel_access_token
# NETLIFY_TOKEN=your_netlify_personal_access_token
